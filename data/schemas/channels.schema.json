{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-chat/data/channels.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's JSON Schema (for editors)."
    }
  },
  "patternProperties": {
    "^[a-z0-9_]{2,32}$": {
      "type": "object",
      "properties": {
        "label": {
          "description": "Name",
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "color": {
          "description": "Colour: Colour of the channel tag and the author, as #RRGGBB.",
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "range": {
          "description": "Range: Only players this close to the writer read it. 0 means everyone on the server.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "jobs": {
          "description": "Jobs: Only members of these jobs can use it. Leave jobs and gangs empty for everyone.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "gangs": {
          "description": "Gangs: Members of these gangs can use it too.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "onDuty": {
          "description": "Only on duty: Job members must be on duty in that job.",
          "type": "boolean"
        },
        "order": {
          "description": "Order: Lower comes first; the first channel is where the chat opens.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "label",
        "color",
        "range",
        "order"
      ]
    }
  },
  "additionalProperties": false
}
